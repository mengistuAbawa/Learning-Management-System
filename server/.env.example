# ============================================================================
# LearnSphere LMS Server Configuration
# ============================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# Client Configuration
# Set this to the exact frontend origin. Production must use HTTPS.
CLIENT_URL=http://localhost:5173

# ============================================================================
# Database Configuration
# ============================================================================

# For Neon or another hosted PostgreSQL provider, set DATABASE_URL. It takes
# precedence over DB_* and uses TLS with certificate verification enabled.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Local PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnsphere_lms
DB_USER=postgres

# SECURITY: Use a strong password for production
# Development password "1234" is acceptable for local development only
# Production: Use at least 16 random characters (letters, numbers, symbols)
DB_PASSWORD=1234

# ============================================================================
# JWT (JSON Web Token) Configuration
# ============================================================================

# SECURITY: JWT_SECRET must be at least 32 random characters
# Generate a secure secret with:
#   For Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   For Python: python3 -c "import secrets; print(secrets.token_hex(32))"
#   For bash: openssl rand -hex 32
# 
# DO NOT use default/simple secrets in production
# DO NOT commit actual secrets to version control
JWT_SECRET=your_64_character_hex_string_here_min_32_chars_recommended_64

JWT_EXPIRES_IN=1d

# ============================================================================
# LiveKit Cloud (server-side only; never put the API secret in the client)
# ============================================================================
# Copy these placeholders into server/.env, replace them with project values,
# then uncomment. LIVEKIT_URL must use wss://.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ============================================================================
# Security Best Practices
# ============================================================================
# 
# 1. Never commit .env files with real secrets to version control
# 2. Rotate JWT_SECRET on a regular schedule (quarterly minimum)
# 3. Use separate secrets for development and production environments
# 4. Restrict database access to application server only
# 5. Enable HTTPS in production (set NODE_ENV=production)
# 6. Monitor rate limiting and anomalous traffic patterns
# 7. Keep dependencies up to date (npm audit, npm update)
# 8. Review security headers (Helmet is enabled by default)
#
